{
  "version": 2,
  "builds": [
    {
      "src": "mail.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "mail.py"
    },
    {
      "src": "/(.*)",
      "dest": "mail.py"
    }
  ],
  "env": {
    "API_KEY": "@api_key"
  }
}
